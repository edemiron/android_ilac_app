{
  "name": "mobile",
  "version": "1.3.2",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:settings": "jest --testPathPatterns \"[Ss]ettings\"",
    "test:caregiver": "jest --testPathPatterns \"[Cc]aregiver\"",
    "test:critical": "jest --testPathPatterns \"(medicineStore|notifications|[Aa]larm|boot|reminder)\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json}\"",
    "prepare": "cd .. && husky mobile/.husky",
    "bundle": "npx react-native bundle --platform android --dev false --entry-file index.ts --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res",
    "build:release": "bash scripts/build-apk.sh",
    "build:device": "bash scripts/build-apk.sh --install --launch",
    "build:aab": "bash scripts/build-apk.sh --aab",
    "sync-version": "node scripts/sync-version.js"
  },
  "dependencies": {
    "@expo/metro-config": "^54.0.14",
    "@expo/vector-icons": "^15.0.3",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-firebase/app": "23.8.8",
    "@react-native-firebase/app-check": "23.8.8",
    "@react-native-firebase/crashlytics": "23.8.8",
    "@react-native-google-signin/google-signin": "^16.1.1",
    "@react-navigation/bottom-tabs": "^7.10.1",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.10.1",
    "date-fns": "^4.1.0",
    "expo": "^54.0.32",
    "expo-camera": "17.0.10",
    "expo-crypto": "14.1.5",
    "expo-font": "^14.0.12",
    "expo-image-picker": "17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-local-authentication": "14.0.1",
    "expo-localization": "17.0.9",
    "expo-notifications": "0.32.4",
    "expo-secure-store": "15.0.8",
    "firebase": "^12.8.0",
    "moti": "^0.30.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-config": "^1.6.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-google-mobile-ads": "^16.0.1",
    "react-native-haptic-feedback": "^2.3.3",
    "react-native-html-to-pdf": "^1.3.0",
    "react-native-inappbrowser-reborn": "^3.7.0",
    "react-native-localize": "^3.6.1",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-share": "^12.2.4",
    "react-native-sound": "^0.13.0",
    "react-native-svg": "15.12.1",
    "react-native-tts": "^4.1.1",
    "react-native-vector-icons": "^10.3.0",
    "react-native-vision-camera": "^4.7.3",
    "react-native-worklets": "0.8.1",
    "uuid": "^11.1.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@babel/plugin-transform-export-namespace-from": "^7.27.1",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@react-native-community/cli": "^20.1.0",
    "@react-native-community/cli-platform-android": "^20.1.0",
    "@react-native/babel-preset": "^0.83.1",
    "@react-native/metro-config": "^0.83.1",
    "@testing-library/react-native": "^13.3.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^9.20.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "expo-build-properties": "1.0.10",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "lint-staged": "^16.0.0",
    "prettier": "^3.5.0",
    "react-test-renderer": "19.1.0",
    "ts-jest": "^29.4.4",
    "typescript": "~5.9.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "private": true
}
