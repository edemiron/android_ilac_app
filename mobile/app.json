{
  "name": "IlacHatirlatici",
  "displayName": "İlaç Hatırlatıcı",
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-3909827768413000~3359162942"
  },
  "expo": {
    "name": "İlaç Hatırlatıcı",
    "slug": "ilac-hatirlatici",
    "version": "2.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4ECDC4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ilachatirlatici",
      "infoPlist": {
        "UIBackgroundModes": ["audio", "fetch", "remote-notification"],
        "NSCameraUsageDescription": "Barkod taramak için kamera erişimi gereklidir.",
        "NSSpeechRecognitionUsageDescription": "Sesli hatırlatmalar için konuşma tanıma gereklidir."
      },
      "buildNumber": "82"
    },
    "scheme": "ilachatirlatici",
    "android": {
      "versionCode": 82,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4ECDC4"
      },
      "package": "com.ilachatirlatici",
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "ilachatirlatici"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "USE_FULL_SCREEN_INTENT",
        "POST_NOTIFICATIONS",
        "CAMERA",
        "FOREGROUND_SERVICE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "ndkVersion": "27.0.12077973"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": ["./assets/alarm.mp3"]
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      "./plugins/withAlarmActivity.js",
      "./plugins/withBootReceiver.js"
    ],
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      },
      "firebase": {
        "apiKey": "AIzaSyAHpY_bOKu1GqFB_Yr4cXk3FSpd8kynfb4",
        "authDomain": "ilachatirlatici-15a71.firebaseapp.com",
        "projectId": "ilachatirlatici-15a71",
        "storageBucket": "ilachatirlatici-15a71.firebasestorage.app",
        "messagingSenderId": "506876057044",
        "appId": "1:506876057044:android:5d2d26ddbe32c8c4d53241"
      },
      "google": {
        "androidClientId": "506876057044-a1dse18hnemqnceocge898ejfp6q8sra.apps.googleusercontent.com",
        "webClientId": "506876057044-a1dse18hnemqnceocge898ejfp6q8sra.apps.googleusercontent.com"
      }
    }
  },
  "version": "2.4.0",
  "android": {
    "versionCode": 82
  },
  "ios": {
    "buildNumber": "82"
  }
}
