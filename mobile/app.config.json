{
  "expo": {
    "name": "İlaç Hatırlatıcı",
    "slug": "ilac-hatirlatici",
    "version": "1.3.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4ECDC4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ilachatirlatici",
      "buildNumber": "15",
      "infoPlist": {
        "UIBackgroundModes": ["audio", "fetch", "remote-notification"],
        "NSCameraUsageDescription": "Barkod taramak için kamera erişimi gereklidir.",
        "NSSpeechRecognitionUsageDescription": "Sesli hatırlatmalar için konuşma tanıma gereklidir."
      }
    },
    "scheme": "ilachatirlatici",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4ECDC4"
      },
      "package": "com.ilachatirlatici",
      "versionCode": 15,
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "ilachatirlatici"
            },
            {
              "scheme": "https",
              "host": "REPLACE_WITH_ENV_FIREBASE_AUTH_DOMAIN",
              "pathPrefix": "/caregiver-invite"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "SCHEDULE_EXACT_ALARM",
        "USE_FULL_SCREEN_INTENT",
        "POST_NOTIFICATIONS",
        "CAMERA",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_SPECIAL_USE",
        "SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "ndkVersion": "27.0.12077973"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": ["./assets/alarm.mp3"]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Barkod taramak için kamera erişimi gereklidir."
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Barkod ve kare kod taramak için kamera erişimi gereklidir.",
          "enableCodeScanner": true
        }
      ],
      "expo-localization",
      "@react-native-google-signin/google-signin",
      "@react-native-firebase/app",
      "@react-native-firebase/app-check",
      "@react-native-firebase/crashlytics",
      "./plugins/withAlarmActivity.js",
      "./plugins/withBootReceiver.js"
    ],
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      },
      "app": {
        "privacyPolicyUrl": "REPLACE_WITH_ENV_PRIVACY_POLICY_URL"
      },
      "firebase": {
        "apiKey": "REPLACE_WITH_ENV_FIREBASE_API_KEY",
        "authDomain": "REPLACE_WITH_ENV_FIREBASE_AUTH_DOMAIN",
        "projectId": "REPLACE_WITH_ENV_FIREBASE_PROJECT_ID",
        "storageBucket": "REPLACE_WITH_ENV_FIREBASE_STORAGE_BUCKET",
        "messagingSenderId": "REPLACE_WITH_ENV_FIREBASE_MESSAGING_SENDER_ID",
        "appId": "REPLACE_WITH_ENV_FIREBASE_APP_ID",
        "functionsBaseUrl": "REPLACE_WITH_ENV_FUNCTIONS_BASE_URL",
        "aiProvider": "gemini"
      },
      "google": {
        "androidClientId": "REPLACE_WITH_ENV_GOOGLE_ANDROID_CLIENT_ID",
        "webClientId": "REPLACE_WITH_ENV_GOOGLE_WEB_CLIENT_ID"
      }
    }
  }
}
