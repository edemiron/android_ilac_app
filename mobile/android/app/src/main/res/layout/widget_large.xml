<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bugünkü İlaçlar"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:id="@+id/medicine_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- İlaç 1 -->
        <LinearLayout
            android:id="@+id/med1_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="6dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/med1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="08:00 - Aspirin"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/med1_taken"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="✓"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_taken"
                android:textSize="12sp"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

        <!-- İlaç 2 -->
        <LinearLayout
            android:id="@+id/med2_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="6dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/med2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="12:00 - Parol"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/med2_taken"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="✓"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_taken"
                android:textSize="12sp"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

        <!-- İlaç 3 -->
        <LinearLayout
            android:id="@+id/med3_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="6dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/med3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="20:00 - Majezik"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/med3_taken"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="✓"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_taken"
                android:textSize="12sp"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

        <!-- İlaç 4 -->
        <LinearLayout
            android:id="@+id/med4_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="6dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/med4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="--:-- - --"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/med4_taken"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="✓"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_taken"
                android:textSize="12sp"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

        <!-- İlaç 5 -->
        <LinearLayout
            android:id="@+id/med5_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="6dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/med5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="--:-- - --"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/med5_taken"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="✓"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_taken"
                android:textSize="12sp"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Daha fazla için uygulamayı açın"
        android:textColor="#888888"
        android:textSize="11sp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:layout_gravity="center_horizontal" />

</LinearLayout>
