# Firebase Configuration
# Bu degerleri Firebase Console'dan alin: https://console.firebase.google.com
# Project Settings > General > Your apps > Firebase SDK snippet
#
# GUVENLIK NOTU: Bu degerler client-side'da gorunur olacaktir.
# Bu tasarim geregi boyledir. Guvenlik su mekanizmalarla saglanir:
# 1. Firestore Security Rules (authentication zorunlu)
# 2. Firebase App Check (attestation)
# 3. API key restrictions (Firebase Console'da)

FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Google OAuth Client IDs
# Bu degerleri Google Cloud Console'dan alin: https://console.cloud.google.com
# APIs & Services > Credentials > OAuth 2.0 Client IDs
GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com

# ============================================
# FIREBASE APP CHECK (Opsiyonel ama Onerilen)
# ============================================

# ReCAPTCHA Enterprise Site Key (Web builds icin)
# Google Cloud Console > reCAPTCHA Enterprise > Create Key
# Key type: "Website" secin ve domain'inizi ekleyin
RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# App Check Debug Token (Sadece development icin)
# Firebase Console > Project Settings > App Check > Apps > Manage debug tokens
# Yeni bir debug token olusturun ve buraya yapistin
# UYARI: Bu token'i production build'lerde KULLANMAYIN!
APPCHECK_DEBUG_TOKEN=your_debug_token_here
