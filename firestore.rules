rules_version = '2';

/**
 * İlaç Hatırlatıcı — Firestore Güvenlik Kuralları
 *
 * ⚠️ v1.7.4 KRİTİK ONARIM (Faz 0.1)
 * ────────────────────────────────────────────────────────────────────────────
 * Eskiden neredeyse her kural `isOwner(userId) || isAuthenticated()` idi.
 * Bu ifade mantıksal olarak `isAuthenticated()`e İNDİRGENİR: e-posta ile
 * ücretsiz hesap açan HERKES
 *   - `users` koleksiyonunu listeleyip isim/e-posta/telefon/pushToken çekiyor,
 *   - herhangi bir kullanıcının ilaç listesini ve doz geçmişini okuyor,
 *   - kurbanın `medicineLogs`una `taken` yazıyor (kurban cihazı union merge
 *     ile bunu yerel state'e alıyor → doz "alındı" görünüyor),
 *   - `caregiverRelationships`e kayıt atıp kendini kurbanın bakıcısı yapıyor,
 *   - kurbanın kilit ekranında SOS / uzaktan hatırlatma tetikliyor.
 * App Check mobilde fiilen kapalı olduğu için tek koruma katmanı bu dosyaydı.
 *
 * YENİ MODEL — "davet kanıtlı deterministik ilişki":
 *   caregiverRelationships doküman kimliği ARTIK `{patientId}__{caregiverId}`.
 *   Böylece kurallar `get()` ile ilişkiyi doğrulayabiliyor (query yapılamaz).
 *   İlişki yalnızca iki yolla kurulabilir:
 *     1) Bakıcı, HASTANIN ürettiği davet kodunu bilerek (kanıt: invite
 *        dokümanının patientId'si eşleşmeli),
 *     2) Hasta kendi ilişkisini yazarak (kendi verisine erişim veriyor).
 *   Yetki yükseltme kapalı: bakıcı ilişkide yalnızca kendi iletişim/token
 *   alanlarını güncelleyebilir; `status` ve izinler yalnızca hastada.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // YARDIMCI FONKSİYONLAR
    // ============================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // İlişki dokümanının deterministik yolu: {patientId}__{caregiverId}
    function relPath(patientId, caregiverId) {
      return /databases/$(database)/documents/caregiverRelationships/$(patientId + '__' + caregiverId);
    }

    // İstek sahibi, {patientId} kullanıcısının AKTİF bakıcısı mı?
    function isActiveCaregiverOf(patientId) {
      return isAuthenticated()
        && exists(relPath(patientId, request.auth.uid))
        && get(relPath(patientId, request.auth.uid)).data.status == 'active';
    }

    // Ters yön: {caregiverId}, istek sahibinin (hastanın) AKTİF bakıcısı mı?
    // Hasta kendi bakıcısının caregiverAlerts kutusuna yazarken kullanılır.
    function isMyActiveCaregiver(caregiverId) {
      return isAuthenticated()
        && exists(relPath(request.auth.uid, caregiverId))
        && get(relPath(request.auth.uid, caregiverId)).data.status == 'active';
    }

    // İlişki dokümanının taraflarından biri mi?
    function isRelationshipParty() {
      return isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.caregiverId == request.auth.uid
      );
    }

    // ============================================
    // KULLANICI VERİ KOLEKSİYONU (/users/{userId})
    // ============================================

    match /users/{userId} {
      // Profil: sahibi ve AKTİF bakıcısı okur (bakıcı isim/telefon görür).
      // `list` de bu kurala tabidir; artık `users` koleksiyonu taranamaz.
      allow read: if isOwner(userId) || isActiveCaregiverOf(userId);
      allow write: if isOwner(userId);

      // ----------------------------------------
      // İLAÇLAR
      // ----------------------------------------
      match /medicines/{medicineId} {
        allow read: if isOwner(userId) || isActiveCaregiverOf(userId);
        allow write: if isOwner(userId);
      }

      // ----------------------------------------
      // HATIRLATMA ZAMANLARI
      // ----------------------------------------
      match /reminderTimes/{timeId} {
        allow read: if isOwner(userId) || isActiveCaregiverOf(userId);
        allow write: if isOwner(userId);
      }

      // ----------------------------------------
      // İLAÇ KULLANIM LOGLARI
      // Bakıcı hastanın dozunu "alındı" işaretleyebilir (aktif ilişki şartı).
      // ----------------------------------------
      match /medicineLogs/{logId} {
        allow read: if isOwner(userId) || isActiveCaregiverOf(userId);
        allow create, update: if isOwner(userId) || isActiveCaregiverOf(userId);
        allow delete: if isOwner(userId);
      }

      // ----------------------------------------
      // AYARLAR — yalnızca sahibi (PIN/güvenlik alanları burada)
      // ----------------------------------------
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }

      // ----------------------------------------
      // REÇETELER — yalnızca sahibi
      // ----------------------------------------
      match /prescriptions/{prescriptionId} {
        allow read, write: if isOwner(userId);
      }

      // ----------------------------------------
      // ABONELİK — istemci YAZAMAZ.
      // v1.7.4: eskiden `allow write: if isOwner(userId)` idi; herkes kendi
      // dokümanına `tier:'premium'` yazıp ödemesiz Premium açabiliyordu.
      // Yazma yalnızca Play Billing makbuzunu doğrulayan sunucuda (Admin SDK
      // kuralları atlar) olmalı.
      // ----------------------------------------
      match /subscription/{subscriptionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // ----------------------------------------
      // BAKICI ALARM KUTUSU — /users/{caregiverId}/caregiverAlerts
      // Kutunun sahibi bakıcıdır; yazan ise HASTADIR.
      // ----------------------------------------
      match /caregiverAlerts/{alertId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isOwner(userId) || isMyActiveCaregiver(userId);
      }

      // ----------------------------------------
      // ACİL DURUM (SOS) — hasta oluşturur, bakıcı okur/onaylar
      // ----------------------------------------
      match /emergencyAlerts/{alertId} {
        allow read, update: if isOwner(userId) || isActiveCaregiverOf(userId);
        allow create, delete: if isOwner(userId);
      }

      // ----------------------------------------
      // UZAKTAN HATIRLATICI (NUDGE) — bakıcı oluşturur, hasta okur/tüketir
      // ----------------------------------------
      match /remoteReminders/{reminderId} {
        allow read, update: if isOwner(userId) || isActiveCaregiverOf(userId);
        allow create: if isOwner(userId) || isActiveCaregiverOf(userId);
        allow delete: if isOwner(userId);
      }

      // Diğer tüm alt koleksiyonlar: yalnızca sahibi
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // ============================================
    // SİSTEM VE AI YAPILANDIRMASI — ARTIK TAMAMEN KAPALI (v1.8.9)
    //
    // KURALIN GEÇMİŞİ, KUSURUN BOYUTUNU ANLATIYOR:
    //   v1.7.4 öncesi : `allow read: if true`   → KİMLİK DOĞRULAMASI YOK.
    //                    Proje kimliğini bilen HERKES `config/ai` dokümanını
    //                    okuyup içindeki `geminiApiKey`'i alabiliyordu.
    //   v1.7.4        : `allow read: if isAuthenticated()` → hâlâ yetersiz;
    //                    kayıt açık olduğu için "herhangi bir kullanıcı" =
    //                    uygulamayı kurup üye olan herkes.
    //   v1.8.9 (bu)   : `allow read: if false`  → hiç kimse.
    //
    // Neden şimdi tamamen kapatılabiliyor: `config/` koleksiyonunu okuyan
    // KOD KALMADI. v1.7.4 (Faz 0.3) istemci tarafı anahtar katmanını
    // kaldırdı; anahtarlar artık yalnızca `server/functions/.env` içinde ve
    // Cloud Functions bunları Admin SDK ile okuyor — Admin SDK bu kuralları
    // ZATEN BYPASS eder, yani buradaki `false` sunucuyu etkilemez.
    //
    // ⚠️ Kuralı kapatmak, DOKÜMANI SİLMEZ. `config/ai` hâlâ eski anahtarı
    // taşıyor olabilir; rotasyon runbook'u onu silmeyi de kapsıyor
    // (bkz. docs/YAYIN_ONCESI_ACIK_MADDELER.md → A1).
    // ============================================

    match /config/{configId} {
      allow read: if false;
      allow write: if false;
    }

    // ============================================
    // GLOBAL DOĞRULANMIŞ İLAÇ KATALOĞU
    // ============================================

    match /globalMedicines/{medicineId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ============================================
    // BAKICI DAVETLERİ
    // Davet kodu bir SIRDIR: kodu bilen doküman kimliğiyle okuyabilir (`get`),
    // ama koleksiyon TARANAMAZ — `list` yalnızca kendi davetleriyle sınırlı.
    // ============================================

    match /caregiverInvites/{inviteCode} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.caregiverId == request.auth.uid
      );

      // Daveti yalnızca hasta kendi adına oluşturur.
      allow create: if isAuthenticated()
        && request.resource.data.patientId == request.auth.uid;

      // Hasta her alanı; bakıcı yalnızca BEKLEYEN daveti kendi üzerine kabul eder.
      allow update: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        (resource.data.status == 'pending' &&
         request.resource.data.caregiverId == request.auth.uid)
      );

      allow delete: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.caregiverId == request.auth.uid
      );
    }

    // ============================================
    // BAKICI–HASTA İLİŞKİSİ (erişim kontrolünün TEK KAYNAĞI)
    //
    // Doküman kimliği ZORUNLU olarak `{patientId}__{caregiverId}` — kurallar
    // `get()` ile doğrulayabilsin diye. Bu yüzden create'te kimlik şekli de
    // denetlenir; aksi halde ilişki hiç kurulamaz.
    // ============================================

    match /caregiverRelationships/{relationshipId} {
      allow get, list: if isRelationshipParty();

      allow create: if isAuthenticated()
        && relationshipId ==
             request.resource.data.patientId + '__' + request.resource.data.caregiverId
        && (
          // (1) Hasta kendi ilişkisini yazıyor (kendi verisine erişim veriyor)
          request.resource.data.patientId == request.auth.uid
          ||
          // (2) Bakıcı, hastanın ürettiği davet kodunu bilerek kabul ediyor
          (
            request.resource.data.caregiverId == request.auth.uid
            && request.resource.data.inviteCode is string
            && exists(/databases/$(database)/documents/caregiverInvites/$(request.resource.data.inviteCode))
            && get(/databases/$(database)/documents/caregiverInvites/$(request.resource.data.inviteCode)).data.patientId
                 == request.resource.data.patientId
          )
        );

      // Hasta her alanı güncelleyebilir (status, izinler).
      // Bakıcı YALNIZCA kendi iletişim/token alanlarını — böylece yetkisi
      // kaldırılan bakıcı kendini yeniden `active` yapamaz.
      allow update: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        (
          resource.data.caregiverId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'caregiverPhone', 'caregiverFcmToken', 'caregiverName', 'updatedAt'
          ])
        )
      );

      allow delete: if isRelationshipParty();
    }

    // ============================================
    // DİĞER TÜM KOLEKSİYONLARA ERİŞİMİ ENGELLE
    // ============================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
