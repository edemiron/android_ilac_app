rules_version = '2';

/**
 * Firestore Security Rules for Ilac Hatirlatici App
 *
 * SECURITY PRINCIPLES:
 * 1. All data requires authentication - no anonymous access
 * 2. Users can only access their own data (data isolation)
 * 3. Write operations validate data structure AND content (regex allowlist)
 * 4. Foreign key validation: medicineLogs.medicineId must reference an existing medicine
 * 5. Rate limiting through Firebase quotas
 *
 * DEPLOYMENT:
 * Deploy these rules using Firebase CLI:
 * firebase deploy --only firestore:rules
 *
 * Or copy to Firebase Console > Firestore > Rules
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPER FUNCTIONS
    // ============================================

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user owns this resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validate string length only
    function isValidString(str, minLen, maxLen) {
      return str is string && str.size() >= minLen && str.size() <= maxLen;
    }

    // Content allowlist for medicine name/dosage:
    // - Turkce harfler + ASCII + yaygin noktalama
    // - Yeni satir, kontrol karakteri ve HTML/XML karakterleri YASAK
    // - Boylece stored XSS ve log injection engellenir
    function isValidMedicineText(str) {
      return str is string
          && str.size() >= 1
          && str.size() <= 200
          && str.matches('^[A-Za-z0-9ğüşıöçĞÜŞİÖÇ .,\\-()/+&%:%µ]+$');
    }

    function isValidDosage(str) {
      return str is string
          && str.size() >= 1
          && str.size() <= 100
          && str.matches('^[A-Za-z0-9ğüşıöçĞÜŞİÖÇ .,\\-()/+&%:%µ/]+$');
    }

    // Note alanlari icin daha gevsek (Turkce cumle yazilabilir)
    function isValidNote(str) {
      return str is string
          && str.size() <= 500
          && str.matches('^[\\s\\S]*$');
    }

    // Note OPSIYONELDIR. Istemci not girilmediginde alani hic gondermez:
    // sanitizeForFirestore() undefined alanlari nesneden siler. Alan zorunlu
    // tutuldugunda notsuz her "ilaci aldim" kaydi reddediliyor, writeBatch
    // atomik oldugu icin de tum senkronizasyon partisi dusuyordu.
    function hasValidOptionalNote(data) {
      return !('note' in data) || isValidNote(data.note);
    }

    // Bakici yetki kontrolu.
    // Uyelik kaydi hastanin alt koleksiyonunda deterministik ID ile tutulur:
    //   users/{patientId}/caregivers/{caregiverId}
    // Boylece kural tek exists() ile dogrular; caregiverRelationships
    // dokumanlarinin rastgele UUID id'si kural icinden aranmak zorunda kalmaz.
    function isActiveCaregiverFor(patientId) {
      return isAuthenticated()
          && exists(/databases/$(database)/documents/users/$(patientId)/caregivers/$(request.auth.uid));
    }

    // Check if request has App Check token (when enforced)
    // Note: This can be enabled once App Check is fully configured
    // function hasValidAppCheckToken() {
    //   return request.auth.token.firebase.app_check == true;
    // }

    // ============================================
    // USER DATA COLLECTION
    // ============================================

    match /users/{userId} {
      // Sahibi tam erisir; aktif bakici SADECE okuyabilir
      // (CaregiverScreen hasta adi/profilini gosterir).
      allow read: if isOwner(userId) || isActiveCaregiverFor(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // ----------------------------------------
      // BAKICI UYELIK KAYITLARI
      // ----------------------------------------
      // Deterministik ID (= bakicinin uid'i) sayesinde diger kurallar
      // exists() ile ucuza yetki dogrulayabilir.
      match /caregivers/{caregiverId} {
        allow read: if isOwner(userId) || request.auth.uid == caregiverId;

        // Bakici YALNIZCA kendi uyeligini olusturabilir ve bunun icin
        // bu hastaya ait, bekleyen bir davet kodunu bilmesi gerekir.
        // Aksi halde herhangi bir kullanici kendini istedigi hastanin
        // bakicisi yapabilirdi (yetki yukseltme).
        allow create: if isAuthenticated()
          && request.auth.uid == caregiverId
          && request.resource.data.inviteCode is string
          && get(/databases/$(database)/documents/caregiverInvites/$(request.resource.data.inviteCode)).data.patientId == userId
          && get(/databases/$(database)/documents/caregiverInvites/$(request.resource.data.inviteCode)).data.status == 'pending';

        // Yetki degisimi iliski dokumaninda tutulur; uyelik kaydi immutable.
        allow update: if false;

        // Hasta bakiciyi cikarabilir, bakici kendi ayrilabilir.
        allow delete: if isOwner(userId) || request.auth.uid == caregiverId;
      }

      // ----------------------------------------
      // MEDICINES SUBCOLLECTION
      // ----------------------------------------
      match /medicines/{medicineId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && isValidMedicineText(request.resource.data.name)
          && isValidDosage(request.resource.data.dosage);

        allow update: if isOwner(userId)
          && isValidMedicineText(request.resource.data.name)
          && isValidDosage(request.resource.data.dosage);

        allow delete: if isOwner(userId);
      }

      // ----------------------------------------
      // REMINDER TIMES SUBCOLLECTION
      // ----------------------------------------
      match /reminderTimes/{timeId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // ----------------------------------------
      // MEDICINE LOGS SUBCOLLECTION
      // ----------------------------------------
      match /medicineLogs/{logId} {
        // Bakici hasta gecmisini gorebilir (canViewHistory UI'da ayrica kontrol edilir).
        allow read: if isOwner(userId) || isActiveCaregiverFor(userId);

        // Create: status enum + foreign key medicineId must reference
        // an existing medicine owned by the same user. Prevents orphaned
        // and injected log entries.
        // Bakici da kayit yazabilir (caregiverService.addCaregiverMedicineLog —
        // 'ilaci verdim' aksiyonu); ayni dogrulamalar gecerlidir.
        allow create: if (isOwner(userId) || isActiveCaregiverFor(userId))
          && request.resource.data.status in ['taken', 'skipped', 'missed']
          && request.resource.data.medicineId is string
          && request.resource.data.medicineId.size() > 0
          && exists(/databases/$(database)/documents/users/$(userId)/medicines/$(request.resource.data.medicineId))
          && hasValidOptionalNote(request.resource.data);

        // Update: status corrections within the same medicineId.
        // medicineId degistirilemez (immutable audit trail).
        allow update: if isOwner(userId)
          && request.resource.data.status in ['taken', 'skipped', 'missed']
          && request.resource.data.medicineId == resource.data.medicineId
          && hasValidOptionalNote(request.resource.data);

        allow delete: if isOwner(userId);
      }

      // ----------------------------------------
      // SUBSCRIPTION SUBCOLLECTION
      // ----------------------------------------
      match /subscription/{subscriptionId} {
        // Subscription state may be read by the owner, but must only be written by trusted backend code.
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }

      // ----------------------------------------
      // SETTINGS SUBCOLLECTION
      // ----------------------------------------
      match /settings/{settingId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }

    // ============================================
    // VERIFIED GLOBAL MEDICINE CATALOG
    // ============================================

    match /globalMedicines/{medicineId} {
      // Only verified catalog items may be read by authenticated users.
      // Client queries must include isVerified == true.
      allow read: if isAuthenticated() && resource.data.isVerified == true;
      allow create, update, delete: if false;
    }

    // ============================================
    // BAKICI DAVETLERI
    // ============================================

    match /caregiverInvites/{inviteCode} {
      // GET: davet kodunun kendisi sirdir — dokuman ID'sini bilen kimlik
      // dogrulanmis kullanici daveti okuyabilir. Kabul akisi bunu gerektirir
      // (bakici, iliski kurulmadan once daveti okumak zorunda).
      allow get: if isAuthenticated();

      // LIST: yalnizca hasta KENDI davetlerini listeleyebilir.
      // Onceden `allow read` (= get + list) herkese aciykti; bu, herhangi bir
      // kullanicinin tum koleksiyonu cekip patientId + davet kodu toplamasina,
      // ardindan istedigi hastanin bakicisi olup saglik gecmisini okumasina
      // izin veriyordu (yetki yukseltme).
      allow list: if isAuthenticated() && resource.data.patientId == request.auth.uid;

      // Daveti yalnizca hasta kendi adina olusturur.
      allow create: if isAuthenticated()
        && request.resource.data.patientId == request.auth.uid
        && isValidString(request.resource.data.patientName, 1, 100)
        && request.resource.data.status == 'pending';

      // Hasta kendi davetini yonetebilir. Davetli bakici ise SADECE
      // status/acceptedAt alanlarini degistirebilir (kabul/expire akisi) —
      // patientId veya permissions degistiremez.
      //
      // Bakici dali artik kimlik dogruluyor: token'daki e-posta davetteki
      // caregiverEmail ile eslesmeli. Aksi halde davet ID'sini ele geciren
      // herhangi bir kullanici daveti 'expired' yapip gercek bakicinin
      // kabulunu engelleyebilirdi.
      allow update: if isAuthenticated()
        && (
          resource.data.patientId == request.auth.uid
          || (
            request.auth.token.email != null
            && request.auth.token.email.lower() == resource.data.caregiverEmail
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt'])
            && request.resource.data.status in ['accepted', 'expired']
          )
        );

      allow delete: if isAuthenticated() && resource.data.patientId == request.auth.uid;
    }

    // ============================================
    // BAKICI ILISKILERI
    // ============================================

    match /caregiverRelationships/{relationshipId} {
      // Taraflardan biri okuyabilir. Client sorgulari patientId veya
      // caregiverId uzerinde filtreledigi icin list islemleri de gecerlidir.
      allow read: if isAuthenticated()
        && (resource.data.patientId == request.auth.uid
            || resource.data.caregiverId == request.auth.uid);

      // Iliskiyi bakici olusturur; uyelik kaydinin (users/{p}/caregivers/{c})
      // ONCE yazilmis olmasi gerekir — yetki tek kaynaktan dogrulanir.
      allow create: if isAuthenticated()
        && request.resource.data.caregiverId == request.auth.uid
        && isActiveCaregiverFor(request.resource.data.patientId);

      // Taraf kimlikleri immutable.
      //
      // YETKI ALANLARINI SADECE HASTA DEGISTIREBILIR. Bakici dali daha once
      // tum alanlari kapsiyordu; bakici kendi canViewHistory/canReceiveAlerts
      // bayraklarini acabiliyordu (kendi yetkisini yukseltme). Bakicinin tek
      // mesru yazma ihtiyaci kendi FCM token'ini guncellemek
      // (updateCaregiverFcmToken).
      allow update: if isAuthenticated()
        && request.resource.data.patientId == resource.data.patientId
        && request.resource.data.caregiverId == resource.data.caregiverId
        && (
          resource.data.patientId == request.auth.uid
          || (
            resource.data.caregiverId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['caregiverFcmToken', 'updatedAt'])
          )
        );

      allow delete: if isAuthenticated()
        && (resource.data.patientId == request.auth.uid
            || resource.data.caregiverId == request.auth.uid);
    }

    // ============================================
    // UYGULAMA KONFIGURASYONU (AI ayarlari)
    // ============================================

    match /config/{configId} {
      // ISTEMCIYE TAMAMEN KAPALI.
      //
      // Onceden `allow read: if isAuthenticated()` idi ve `config/ai`
      // dokumani geminiApiKey / openaiApiKey alanlarini DUZ METIN tutuyordu.
      // Yani uygulamaya kaydolan herkes AI API anahtarlarini cekebiliyordu.
      //
      // AI ozelligi tamamen kaldirildi ve config/ai dokumani silindi.
      // Kural savunma amaciyla duruyor: ileride buraya bir sey yazilirsa
      // istemciye acik olmasin.
      allow read, write: if false;
    }

    // ============================================
    // DENY ALL OTHER ACCESS
    // ============================================

    // Catch-all rule: deny access to any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
